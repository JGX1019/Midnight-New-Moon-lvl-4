{
  "name": "midnight-anonymous-survey",
  "version": "1.0.0",
  "description": "Anonymous feedback survey dApp on Midnight — verifiable participation, private responses (Level 3 Builder Challenge)",
  "type": "module",
  "scripts": {
    "compile": "npm run compile:survey && npm run compile:counter",
    "compile:survey": "compact compile contracts/survey.compact managed/survey",
    "compile:counter": "compact compile contracts/counter.compact managed/counter",
    "copy-assets": "mkdir -p public/managed/survey/keys public/managed/survey/zkir && cp managed/survey/keys/* public/managed/survey/keys/ && cp managed/survey/zkir/* public/managed/survey/zkir/ && cp managed/survey/contract/index.js src/contract/survey.js && cp managed/survey/contract/index.d.ts src/contract/survey.d.ts",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:preprod": "npx tsx src/deploy.ts --network preprod",
    "deploy:preview": "npx tsx src/deploy.ts --network preview",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --testPathPattern=tests/",
    "test:run": "node --experimental-vm-modules node_modules/.bin/jest --testPathPattern=tests/ --forceExit"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "^0.16.0",
    "@midnight-ntwrk/dapp-connector-api": "^4.0.1",
    "@midnight-ntwrk/midnight-js-contracts": "^4.1.1",
    "@midnight-ntwrk/midnight-js-dapp-connector-proof-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-fetch-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "^4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "^4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "^4.1.1",
    "@midnight-ntwrk/midnight-js-types": "^4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "^4.1.1",
    "@midnight-ntwrk/wallet-sdk": "^1.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rxjs": "^7.8.2",
    "semver": "^7.8.5",
    "tsx": "^4.23.1",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-wasm": "^3.6.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/semver": "^7.7.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "jest": "^29.7.0",
    "rollup": "^4.62.4",
    "ts-jest": "^29.1.4",
    "typescript": "^6.0.3",
    "vite": "^6.3.5"
  },
  "overrides": {
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
